:: Widgets Bodywriting Objects [widget]
<<widget "init_bodywriting_objects">>
	/*fuckdoll isn't used yet.*/
	<<set setup.bodywriting to {
		virile: {
			index: 195,
			writing: "Virile",
			type: "text",
			arrow: 0,
			special: "impreg",
			gender: "m",
			lewd: 1,
			degree: 0
		},
		womb_filler: {
			index: 196,
			writing: "Womb filler",
			type: "text",
			arrow: 0,
			special: "impreg",
			gender: "m",
			lewd: 1,
			degree: 0
		},
/****remy mod */
		remy_little_cow: {
			index: 200,
			writing: "Remy little cow",writ_cn: "雷米的小奶牛",
			type: "text",
			arrow: 0,
			special: "Remy",
			gender: "n",
			lewd: 0,
			degree: 0,
			featSkip: true
			},

		please_give_me_pain: {
			index: 201,
			writing: "Please give me pain",writ_cn: "鞭打我",
			type: "text",
			arrow: 0,
			special: "Remy",
			gender: "n",
			lewd: 1,
			degree: 0,
			featSkip: true
			},

		give_me_more: {
			index: 203,
			writing: "Give me more",writ_cn: "主人我还要",
			type: "text",
			arrow: 0,
			special: "Remy",
			gender: "n",
			lewd: 1,
			degree: 0,
			featSkip: true
			}
	}>>
	<<set setup.bodywriting_namebyindex to []>>
	<<for _label, _value range setup.bodywriting>>
		<<set setup.bodywriting_namebyindex[_value.index] to _label>>
	<</for>>
<</widget>>
