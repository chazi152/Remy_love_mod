							<<elseif $consensual is 0 and $enemyhealth lte ($enemyhealthmax / 10) * 9>>
								<<switch random(1, 2)>>
									<<case 1>>
										<<if $NPCName[$NPCNameList.indexOf("Remy")].dom gte 60 or $livestock_obey lt 30>>
											<span class="red"><<He>>把你按在地上，狠狠地掐住了你的脖子。</span>
											<<print either(
												`"这是你自找的，不懂感恩的畜生！"`,
												`"我是你的主人，我想对你做什么就做什么！"`,
												`"到此为止了！"`
											)>>
											面对<<his>>接下来的施暴，你无能为力，只能蜷缩起来保护自己，直到<<his>>的愤怒最终平息。
											<<trauma 6>><<gtrauma>><<stress 6>><<gstress>><<pain 6>><<gpain>><<violence 6>>
										<<else>>
											<span class="pink"><<He>>用力地扯住你的头发，狠狠扇了几个耳光。</span>
											<<print either(
												`"够了，你以为你是谁？"`,
												`"你这头愚蠢的牲畜！"`
											)>>
											<<trauma 6>><<gtrauma>><<stress 6>><<gstress>><<pain 6>><<gpain>><<violence 3>>
										<</if>>
									<<default>>
										<<if ($neckuse is "hand" or random(1, 5) is 1) and $asphyxiaLvl gte 2>>
											<<if $NPCName[$NPCNameList.indexOf("Remy")].dom gte 60 or $livestock_obey lt 30>>
												<span class="red"><<He>>狠狠地掐住你的脖子。</span>你感觉难以呼吸，想要挣脱开<<he>>的手，却是徒劳的。
												<<print either(
													`"你这头愚蠢的动物！"`,
													`"难受吗？这都是你自找的！"`,
													`"该死的畜生，你没有反抗我的资格！"`,
													`"你还学不乖的话，我不介意教教你！"`
												)>>
												不知过了多久，<<He>>才松开手。
												<<gtrauma>><<gstress>><<gpain>><<violence 8>><<pass 10>>
											<<elseif $NPCName[$NPCNameList.indexOf("Remy")].dom gte 30>>
												<span class="pink"><<He>>掐住你的脖子，死死地盯着你。</span>
												<<print either(
													`"你这个低贱的东西！"`,
													`"我的宽容只能到此为止。"`,
													`"或许你更适合去犁地。"`,
													`"我的耐心有限。"`
												)>>
												不知过了多久，<<He>>才松开手。
												<<gtrauma>><<gstress>><<gpain>><<violence 5>><<pass 10>>
											<<else>>
												<<He>>抚摸着你的脖子。
												<<print either(
													`"你不想让我失望吧？"`,
													`"从现在开始，你会乖乖的，对吧？"`
												)>>
												<span class="purple">你瑟瑟发抖。</span>
												<<stress 4>><<trauma 6>><<gtrauma>><<gstress>>
											<</if>>
										<<else>>
											<<if $NPCName[$NPCNameList.indexOf("Remy")].dom gte 60 or $livestock_obey lt 30>>
												<span class="red"><<He>>捏住你的下巴，狠狠地扇了几个耳光，</span><<hes>>的力度非常大，痛的你怀疑脸是不是高高肿起来了。
												<<print either(
													`"不听主人的话，就是这样的下场！"`,
													`"我没时间陪你这种下贱的动物玩游戏！"`,
													`"你这个低贱的东西！"`,
													`"<<bitch>>，你应得的！"`
												)>>
												<<trauma 6>><<gtrauma>><<stress 6>><<gstress>><<pain 6>><<gpain>><<violence 6>>
											<<else>>
												<<He>><span class="pink">一拳打在了你的脸上。</span><<He>>用手帕擦了擦自己的手，然后冷笑一声。
												<<print either(
													`"动物就是动物！"`,
													`"看来你这头肮脏的牲畜更喜欢和猪在一起！"`,
													`"再不涨教训，这就是你的下场。"`
												)>>
												<<trauma 6>><<gtrauma>><<stress 6>><<gstress>><<pain 6>><<gpain>><<violence 3>>
											<</if>>
										<</if>>
								<</switch>>	
								<br><br>
							<<else>>
								/***nothing */	
							<</if>>
						<<case "Alex">>
							<<if $consensual is 1 and $enemyanger lte 0>>
								<<switch random(1, 3)>>
									<<case 3>>
										<<if $farm_stage gte 7 and $alex_countdown is undefined>>
											<<if $NPCName[$NPCNameList.indexOf("Alex")].dom gte 30>>
												<<He>>笑着揉乱了你的头发。
												<<print either(
													`"别走太远，我们很快就会再做一次。"`,
													`"这段时间操得最爽的一次。"`,
													`"你可太他妈的可爱了。"`,
													`"这才是我的<<girl>>。"`
												)>>
											<<elseif $NPCName[$NPCNameList.indexOf("Alex")].dom lte -30>>
												<<He>>紧紧抱住你，在你的胸口上叹息。
												<<print either(
													`"我到底做了什么值得你这样做？"`,
													`"没有你我该怎么办？"`,
													`"你可太他妈的可爱了。"`,
													`"我是你的<<if $pronoun is "f">>女<<else>>男<</if>>人……"`
												)>>
											<<else>>
												<<He>>把<<his>>的额头贴在你的额头上。
												<<print either(
													`"我从不认为自己是那种能安定下来的人……但你值得我这么做。"`,
													`"谁能想到我会爱上一个城里人呢？"`,
													`"你可太他妈的可爱了。"`,
													`"你是我的<<if $player.gender_appearance is "f">>女<<else>>男<</if>>人……"`
												)>>
											<</if>>
										<<else>>
											<<He>>笑着拍了拍你的<<bottom>>。
											<<print either(
												`"别走太远，我们很快就会再做一次。"`,
												`"有你在这活干得真不错。"`,
												`"你真是个坏<<girl>>，让我都懈怠了。"`
											)>>
										<</if>>
										<span class="green">你的脸因高兴而通红。</span>
										<<lstress>><<ltrauma>><<lpain>><<violence -3>>
									<<case 2>>
										<<if $NPCName[$NPCNameList.indexOf("Alex")].dom gte 10>>
											<<He>>抚摸着你的下巴，
										<<else>>
											<<He>>把头靠在你的肩膀上，
										<</if>>
										<span class="green">让你感到内心温暖。</span>
										<<lstress>><<ltrauma>><<lpain>><<violence -3>>
									<<default>>
										<<if $NPCName[$NPCNameList.indexOf("Alex")].dom gte 10>>
											<<He>>把你抱在怀里，
										<<else>>
											<<He>>躺在你的怀里，
										<</if>>
										<span class="green">让你感到内心温暖。</span>
										<<lstress>><<ltrauma>><<lpain>><<violence -3>>
								<</switch>>
								<br><br>
							<</if>>
	<!-- Finishing moves for consensual with low anger or non-consensual with enemy damage -->
	<<if _args[0] isnot "short">>
		<<if $npc.length is 0>>
			<<if $position isnot "wall">>
				<<if $punishmentposition isnot "gloryhole" and not $gloryhole>>
					<!-- Disregard named NPCs and Pillory / Wall -->
					<<if $consensual is 1 and $enemyanger lte 0 and $NPCList[0].fullDescription isnot "Ivory Wraith">>
						<<if $enemyno is 1>>
							<<switch random(1, 6)>>
							<<case 1 2>>
								<<He>>心不在焉地抚摸你，<span class="green">让你感到内心温暖。</span>
								<<lstress>><<ltrauma>><<lpain>><<violence -3>>
								<br><br>
							<<case 3 4>>
								<<He>>抚摸你的头发，<span class="green">让你感到内心温暖。</span>
								<<lstress>><<ltrauma>><<lpain>><<violence -3>>
								<br><br>
							<<case 5 6>>
								<<He>>用<<his>>的手轻拂你的脸颊。"你真<<if $player.gender_appearance is "m">>帅<<else>>美<</if>>！"<span class="green">你高兴得满脸通红。</span>
								<<lstress>><<ltrauma>><<lpain>><<violence -3>>
								<br><br>
							<</switch>>
						<<elseif $enemyno gte 2>>
							他们抚摸着你，<span class="green">让你感到内心温暖。</span>
							<<lstress>><<ltrauma>><<lpain>><<violence -6>>
							<br><br>
						<</if>>

					<<elseif $consensual is 0 and $mouthuse is "facesit" and $enemyhealth lte ($enemyhealthmax / 10) * 9 and $NPCList[0].fullDescription isnot "Ivory Wraith">>
						<<if $mouthstate is "anal">>
							<<selectNpcWithPartInPosition "vagina" "facesitanal">>
						<<else>>
							<<selectNpcWithPartInPosition "vagina" "facesit">>
						<</if>>
						<<if $npcrow.includes(_j)>>
							<<print $npc[$npcrow.indexOf(_j)].replace("Avery","艾弗里").replace("Bailey","贝利").replace("Briar","布莱尔").replace("Charlie","查里").replace("Darryl","达里尔").replace("Doren","多伦").replace("Eden","伊甸").replace("Gwylan","格威岚").replace("Harper","哈珀").replace("Jordan","约旦").replace("Kylar","凯拉尔").replace("Landry","兰德里").replace("Leighton","礼顿").replace("Mason","梅森").replace("Morgan","摩根").replace("River","瑞沃").replace("Robin","罗宾").replace("Sam","萨姆").replace("Sirris","西里斯").replace("Whitney","惠特尼").replace("Winter","温特").replace("Niki","尼奇").replace("Quinn","奎恩").replace("Remy","雷米").replace("Alex","艾利克斯").replace("Wren","伦恩").replace("Sydney","悉尼").replace("Taylor","泰勒").replace("Casey","凯西").replace("Ivory Wraith","象牙怨灵").replace("Black Wolf","黑狼").replace("Great Hawk","巨鹰").replace("Zephyr","泽菲尔")>>
						<<else>>
							<<person>>
						<</if>>
						咆哮道："你不该反抗
						<<if $enemyno gte 2>>我们<<else>>我<</if>>。"
						<br><br>

						<<switch random(1)>>
							<<case 0>>
								<<He>>向前伸手压住你的脸，捏住你的<<nipples>>。
								<<if $worn.upper.exposed lt 2 and $worn.under_upper.exposed lt 1>>隔着你的<<top>>，<</if>>
								你大声哭泣，但是被<<his>>的小穴和屁股止住了声音。
								<<if $enemyno gte 2>>
									<<His>><<if $enemyno gt 2>>朋友们笑着<<else>>朋友笑着<</if>>看<<he>>像这样折磨着你，直到<<he>>最终放过你。
								<<else>>
									<<He>>反复做了好几次，在你无助地随<<him>>玩弄时折磨你，直到<<he>>放过你。
								<</if>>
								<<gstress>><<gtrauma>><<gpain>><<violence 3>>
								<br><br>
							<<case 1>>
								<<He>>略微抬身，然后狠狠地落在你的脸上，把你压在<<him>>身下。
								<<He>>继续用屁股坐到你的脸上，一次次地用力将屁股砸向你的脸，作为惩罚。
								<<if $enemyno gte 2>>
									<<His>><<if $enemyno gt 2>>朋友们笑着<<else>>朋友笑着<</if>>看<<he>>继续猥亵你的脸。
								<</if>>
								<<He>>终于停了下来，从你淤青的脸上爬了起来。
								<<gstress>><<gtrauma>><<gpain>><<bruise face>><<violence 3>>
								<br><br>
						<</switch>>
